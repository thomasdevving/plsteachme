NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_DEMO_APP_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared account authentication and optional social providers.
SUPABASE_ANON_KEY=
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
# Teacher/community sign-in: a public publishable key, never the service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated verified Supabase Auth user IDs. Only these accounts review.
PLATFORM_REVIEWER_IDS=
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
RESEND_API_KEY=
ENABLE_CONFIRMATION_EMAIL=false
CONFIRMATION_EMAIL_FROM=
CONTACT_EMAIL=

# Automatic camera coaching (server-only; restart after configuring)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional independent cookie-signing secret; defaults to the API key.
COACHING_SESSION_SECRET=
# Local/test-only simulation. Ignored in production.
MOCK_VERIFIER=false
# Organization training workspace: comma-separated verified emails allowed in.
# Unset defaults to the owner account; set empty to close it to everyone.
TRAINING_ACCESS_EMAILS=thomastheconguyen@gmail.com
# Vision lab staff besides PLATFORM_REVIEWER_IDS: comma-separated verified emails.
# Unset defaults to the owner account; set empty for reviewers only.
VISION_LAB_EMAILS=thomastheconguyen@gmail.com
