NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_DEMO_APP_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared account authentication and optional social providers.
SUPABASE_ANON_KEY=
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
# Teacher/community sign-in: a public publishable key, never the service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated verified Supabase Auth user IDs. Only these accounts review.
PLATFORM_REVIEWER_IDS=
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
RESEND_API_KEY=
ENABLE_CONFIRMATION_EMAIL=false
CONFIRMATION_EMAIL_FROM=
# Verified sender for pilot and invitation emails (needs RESEND_API_KEY).
EMAIL_FROM=
# At least 24 random characters; also add it as the GitHub secret MAINTENANCE_SECRET.
MAINTENANCE_SECRET=
# Cloudflare Turnstile site key for the sign-in form. Enable CAPTCHA protection with
# Turnstile (and its secret key) in Supabase Auth too.
TURNSTILE_SITE_KEY=
# Public test phase limits (defaults shown): all AI calls per day across the service,
# and the free session's AI checks and duration.
AI_DAILY_CALL_LIMIT=3000
TRIAL_MAX_AI_CALLS=150
TRIAL_MAX_MINUTES=120
# Only for staff testing on a deployed site: the /coach/eval page and ?debug=1 panel.
ENABLE_INTERNAL_TOOLS=false
CONTACT_EMAIL=

# Automatic camera coaching (server-only; restart after configuring)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional independent cookie-signing secret; defaults to the API key.
COACHING_SESSION_SECRET=
# Local/test-only simulation. Ignored in production.
MOCK_VERIFIER=false
# Organization training staff: comma-separated verified emails that manage pilot
# access on /training. Unset defaults to the owner account.
TRAINING_ACCESS_EMAILS=thomastheconguyen@gmail.com
# Vision lab staff besides PLATFORM_REVIEWER_IDS: comma-separated verified emails.
# Unset defaults to the owner account; set empty for reviewers only.
VISION_LAB_EMAILS=thomastheconguyen@gmail.com

# Voice coaching with Bolna (server-only; see docs/VOICE.md). Missing values make voice
# coaching show as unavailable; the lesson, camera coach and questions keep working.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# At least 24 random characters each. The tool secret is the agent tools' Bearer token;
# the webhook secret goes in the agent webhook's x-plsteach-webhook-secret header.
BOLNA_TOOL_SECRET=
BOLNA_WEBHOOK_SECRET=
# graph: a Graph Agent with event edges announces camera results. tools: any agent; the
# coach fetches the latest camera check when the learner asks.
BOLNA_AGENT_MODE=graph
# Optional. Defaults to https://api.bolna.ai and /web-call/session (then /web-call/freeswitch-session).
BOLNA_API_BASE=
BOLNA_WEB_CALL_SESSION_PATH=
# Bolna's documented source IPs for tools and webhooks. Leave empty to skip the IP check.
BOLNA_SOURCE_IPS=13.203.39.153,13.126.9.249,13.202.133.53
# Must equal the agent's Total Call Timeout. Each call reserves this much of the allowance.
VOICE_MAX_CALL_SECONDS=300
# Voice minutes per account for the free session, and for the whole service per day.
VOICE_ALLOWANCE_MINUTES=15
VOICE_DAILY_MINUTE_LIMIT=240
