# Automatic camera coaching (server-only; restart after configuring)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional independent cookie-signing secret; defaults to the API key.
COACHING_SESSION_SECRET=
