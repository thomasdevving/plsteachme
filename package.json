{
  "name": "plsteach-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "validate:skills": "node --import tsx scripts/validate-skills.ts",
    "build": "npm run validate:skills && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "lucide-react": "1.55.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/lora": "5.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.30",
    "vitest": "5.0.4",
    "tsx": "4.23.15",
    "@playwright/test": "1.64.0"
  },
  "type": "module"
}
