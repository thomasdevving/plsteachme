{
  "name": "plsteach-me",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:vision && next dev --hostname 0.0.0.0 -p 3100",
    "build": "npm run prepare:vision && npm run validate:skills && next build --webpack",
    "start": "next start --hostname 0.0.0.0 -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:rls": "node scripts/verify-rls.mjs",
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "validate:skills": "node --import tsx scripts/validate-skills.ts",
    "test:browser": "playwright test --config=playwright.coach.config.ts",
    "test:camera-fixture": "node tests/preview-server.mjs",
    "test:camera-flow": "node tests/capture-live.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7",
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "idb-keyval": "^6.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lighthouse": "^13.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.2",
    "postcss": "8.5.30",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "vite": "8.3.4"
  },
  "type": "module"
}
