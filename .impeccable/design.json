      "css": ".ds-status{font-family:var(--font-body),sans-serif;display:inline-flex;align-items:center;gap:7px;line-height:1.35;border:1px solid var(--line);padding:5px 9px;border-radius:50px;font-size:.73rem;color:var(--ink)}.ds-status span{width:5px;height:5px;background:var(--accent);border-radius:50%}@media(max-width:600px){.ds-status{font-size:.65rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Text portion of the integrated English-only BrandMark navigation; source adds optically cropped, em-scaled supplied hands transparently before the contiguous name. Raster asset is not redrawn in this self-contained snippet.",
      "html": "<header class=\"ds-nav\"><a class=\"ds-brand\" href=\"#\"><span class=\"ds-brand-name\"><span class=\"ds-green\">plsteach</span><span class=\"ds-orange\">.me</span></span></a><nav class=\"ds-links\" aria-label=\"Main menu\"><a href=\"#how\">How it works</a><a href=\"#skills\">Skills</a></nav><a class=\"ds-join\" href=\"#waitlist\">I want to try this</a></header>",
      "css": ".ds-nav{font-family:var(--font-body),sans-serif;display:flex;align-items:center;gap:25px;min-height:94px;border-bottom:1px solid var(--line);background:var(--paper);color:var(--ink)}.ds-nav a{text-decoration:none}.ds-brand{font-size:1.75rem;font-weight:600;letter-spacing:-.035em;line-height:1;white-space:nowrap}.ds-green{color:var(--brand-text-green)}.ds-orange{color:var(--brand-text-orange)}.ds-links{display:flex;gap:24px;margin-left:auto;font-size:.81rem}.ds-join{display:inline-flex;align-items:center;justify-content:center;margin-left:auto;min-height:44px;padding:10px 17px;border:1px solid transparent;border-radius:7px;font-size:.82rem;font-weight:600;line-height:1.4;text-align:center;background:var(--accent);color:var(--on-accent);transition:background-color .2s ease}.ds-join:hover{background:var(--accent-hover)}.ds-links a:hover{color:var(--accent)}.ds-nav a:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}@media(max-width:800px){.ds-links{display:none}}@media(max-width:600px){.ds-nav{min-height:76px;gap:10px}.ds-brand{font-size:1.15rem}.ds-join{font-size:.7rem;padding:10px;min-height:43px;max-width:122px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.ds-brand{display:inline-flex;align-items:center;gap:.18em}.ds-brand-name{display:inline-flex;align-items:baseline;line-height:1;letter-spacing:-.035em}"
    },
    {
      "name": "Module Filters",
      "kind": "chip",
      "refersTo": "module-filter",
      "description": "Four category controls for nine modules; this self-contained preview illustrates selected state and counts.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Filter learning modules\"><button aria-pressed=\"true\">All skills<span>9</span></button><button aria-pressed=\"false\">Everyday<span>4</span></button><button aria-pressed=\"false\">Personal care<span>2</span></button><button aria-pressed=\"false\">Make &amp; mend<span>3</span></button></div>",
      "css": ".ds-filters{font-family:var(--font-body),sans-serif;display:flex;flex-wrap:wrap;gap:8px}.ds-filters button{font-family:var(--font-body),sans-serif;border:1px solid var(--line);border-radius:7px;background:transparent;min-height:44px;padding:8px 13px;color:var(--ink);font-size:.8rem;cursor:pointer}.ds-filters span{margin-left:9px;font-size:.7rem;opacity:.8;font-variant-numeric:tabular-nums}.ds-filters button[aria-pressed=true]{background:var(--ink);color:var(--paper);border-color:var(--ink)}.ds-filters button:hover:not([aria-pressed=true]){background:var(--soft)}.ds-filters button:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}@media(max-width:600px){.ds-filters{gap:7px}.ds-filters button{font-size:.73rem;padding:8px 10px}.ds-filters span{margin-left:6px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Module Text Preview",
      "kind": "custom",
      "refersTo": "module-preview",
      "description": "Static state of the source three-step, focusable preview region; application handles next/back, close and focus restoration.",
      "html": "<section class=\"ds-preview\" aria-labelledby=\"ds-preview-title\" tabindex=\"-1\"><div class=\"ds-preview-intro\"><h3 id=\"ds-preview-title\">Tying a tie</h3><p>Three small steps to get started.</p><small>Text preview \u00b7 no camera or AI feedback</small></div><div><div class=\"ds-rail\" aria-hidden=\"true\"><span class=\"ds-complete\"></span><span></span><span></span></div><div class=\"ds-lesson\"><span>Step 1 of 3</span><p>Start with the wide end longer than the narrow end.</p></div><p class=\"ds-tip\">Keep the fabric flat. You can always start again.</p><div class=\"ds-preview-controls\"><button disabled>Back</button><button class=\"ds-next\">Next preview step<svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></div></div><button class=\"ds-close\" aria-label=\"Close module preview\">\u00d7</button></section>",
      "css": ".ds-preview{font-family:var(--font-body),sans-serif;position:relative;display:grid;grid-template-columns:.75fr 1.25fr;gap:60px;margin-top:30px;padding:40px;background:var(--soft);color:var(--ink);border-radius:14px}.ds-preview-intro h3{font-family:var(--font-lora),serif;font-size:1.8rem;font-weight:400;margin:0}.ds-preview-intro p{font-size:.9rem;margin-top:13px}.ds-preview-intro small{display:block;color:var(--muted);margin-top:20px;font-size:.7rem}.ds-rail{display:flex;gap:7px;margin-bottom:20px;max-width:200px}.ds-rail span{height:4px;flex:1;background:var(--line);border-radius:2px}.ds-rail .ds-complete{background:var(--accent)}.ds-lesson{min-height:125px}.ds-lesson>span{font-size:.75rem;color:var(--muted);font-variant-numeric:tabular-nums}.ds-lesson p{font:400 1.4rem/1.45 var(--font-lora),serif;margin:8px 0 0}.ds-tip{font-size:.83rem;color:var(--muted);margin:18px 0 25px}.ds-preview-controls{display:flex;gap:10px;flex-wrap:wrap}.ds-preview button{font-family:var(--font-body),sans-serif;cursor:pointer;border:1px solid var(--line);border-radius:7px;background:transparent;color:var(--ink)}.ds-preview-controls button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:44px;padding:10px 17px;font-size:.82rem;font-weight:600}.ds-preview-controls button:disabled{opacity:.65;cursor:default}.ds-preview-controls .ds-next{background:var(--accent);color:var(--on-accent);border-color:transparent}.ds-next:hover{background:var(--accent-hover)}.ds-close{position:absolute;right:10px;top:10px;min-width:44px;min-height:44px;font-size:1.3rem;border:0!important}.ds-close:hover{background:var(--surface)}.ds-preview button:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}@media(max-width:800px){.ds-preview{gap:30px;padding:30px}}@media(max-width:600px){.ds-preview{grid-template-columns:1fr;gap:28px;padding:25px 22px}.ds-preview-intro h3{font-size:1.5rem}.ds-preview-intro p{font-size:.82rem}.ds-preview-intro small{margin-top:10px}.ds-lesson{min-height:115px}.ds-lesson p{font-size:1.25rem}.ds-preview-controls button{font-size:.75rem;padding-inline:12px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
      "name": "Coaching Step and Controls",
      "kind": "custom",
      "refersTo": "coach-control",
      "description": "Self-contained sample of the interactive phone instruction and controls; source CoachPreview owns seven-step state and sample feedback.",
      "html": "<div class=\"ds-coach\"><div class=\"ds-phone-rail\" role=\"progressbar\" aria-label=\"Example progress\" aria-valuemin=\"1\" aria-valuemax=\"7\" aria-valuenow=\"3\" aria-valuetext=\"Step 3 of 7\"><span class=\"ds-done\"></span><span class=\"ds-done\"></span><span class=\"ds-done\"></span><span></span><span></span><span></span><span></span></div><p class=\"ds-step-index\">Step 3 of 7</p><p class=\"ds-coach-title\">Wrap the wide end behind.</p><div class=\"ds-coach-controls\"><button aria-label=\"Previous example step\">\u2190</button><button>Next step<svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></div><small>Example screen \u00b7 no live camera \u00b7 sample feedback</small></div>",
      "css": ".ds-coach{font-family:var(--font-body),sans-serif;max-width:280px;color:#26392f}.ds-phone-rail{display:flex;gap:4px;margin-bottom:18px}.ds-phone-rail span{height:3px;background:#d9dcd1;flex:1;border-radius:2px}.ds-phone-rail .ds-done{background:var(--brand-orange)}.ds-step-index{font-size:10px;margin:0 0 7px;color:#5e685e}.ds-coach-title{font:400 1.3rem/1.35 var(--font-lora),serif;max-width:18ch;margin:0}.ds-coach-controls{display:flex;justify-content:center;gap:8px;margin-top:25px}.ds-coach-controls button{font-family:var(--font-body),sans-serif;display:flex;align-items:center;justify-content:center;gap:10px;min-width:44px;min-height:44px;background:var(--surface);border:1px solid var(--line);color:var(--ink);border-radius:7px;padding:8px 14px;font-size:.78rem;font-weight:600;cursor:pointer}.ds-coach-controls button:hover:not(:disabled){background:var(--tint)}.ds-coach-controls button:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}.ds-coach-controls button:disabled{opacity:.65;cursor:default}.ds-coach small{display:block;margin-top:15px;font-size:.6rem;text-align:center;color:var(--muted)}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    }
  ],
  "narrative": {
    "northStar": "A calm lesson companion",
    "overview": "Warm paper, deep green and orange give practical learning a patient, human setting. Lora carries the mission and larger headings; DM Sans keeps navigation, explanations and controls clear. Flat color bands, fine line illustrations and generous space retain the established handbook character.\n\nThe supplied two-hands mark anchors the current identity. Its compact optical lockup feels integrated with the contiguous green \u201cplsteach\u201d and orange \u201c.me\u201d wordmark; the second hero phrase repeats that orange. This is an English-only website with root-level canonical URLs. Its phone is a controllable coaching example, and the nine modules offer explicitly labelled text previews; neither implies a live camera or AI feedback session.",
    "keyCharacteristics": [
      "Supplied hands mark with a green/orange wordmark.",
      "A light cream public canvas, a warmer cream story band and quiet flat surfaces.",
      "Serif mission phrases paired with readable sans-serif interaction.",
      "Six hero module choices, seven-step sample coaching and nine filterable text-preview modules.",
      "Visible keyboard focus, reduced motion and a public canvas independent of OS theme."
    ],
    "rules": [
      {
        "name": "The Semantic Surface Rule",
        "body": "Keep public surfaces light cream through runtime palette variables; preserve the warmer cream story band and fixed light illustration interior. Dark tokens are development-gallery variants only.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Lora for mission, major headings and personal notes; use DM Sans for explanations and interaction.",
        "section": "typography"
      },
      {
        "name": "The Flat Interface Rule",
        "body": "Keep controls, cards and content bands shadowless; reserve ambient lift for the coaching illustration.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the supplied hands asset, compact optical lockup and contiguous green \u201cplsteach\u201d / orange \u201c.me\u201d relationship.",
      "Do keep the second hero phrase orange and the website interface English-only.",
      "Do keep public page backgrounds light cream, including the warmer cream story band, regardless of the OS theme.",
      "Do label text previews and sample coaching honestly, with visible focus and static reduced-motion content.",
      "Do retain the compact signup action, wrapping filters and readable preview controls at 375px."
    ],
    "donts": [
      "Don't redraw the supplied hands logo, add a tile to the header lockup or separate \u201cplsteach\u201d from \u201c.me.\u201d",
      "Don't add shadows to interface cards, fields or preview panels.",
      "Don't turn step progress, sample feedback or module previews into camera-analysis claims.",
      "Don't replace the established line drawings with stock photos, robots or purple gradients.",
      "Don't animate the continuous loop when it is offscreen or the document is hidden."
    ]
  }
