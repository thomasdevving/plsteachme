      "html": "<div class=\"ds-field\"><label for=\"ds-email\">Email address</label><input id=\"ds-email\" type=\"email\" placeholder=\"you@example.com\"/></div>",
      "css": ".ds-field{font-family:var(--font-body),sans-serif;display:flex;flex-direction:column;gap:8px;color:var(--ink)}.ds-field label{font-size:.9rem;font-weight:600}.ds-field input{font-family:var(--font-body),sans-serif;background:var(--surface);border:1px solid var(--line);border-radius:7px;width:100%;min-height:51px;padding:12px 14px;color:var(--ink);font-size:.95rem;caret-color:var(--accent)}.ds-field input::placeholder{color:var(--muted)}.ds-field input:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}@media(max-width:600px){.ds-field input{font-size:16px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
    {
