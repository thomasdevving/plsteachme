      "refersTo": "chip",
      "description": "Pill selection controls with unselected and selected aria-pressed states.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" type=\"button\" aria-pressed=\"false\">Tying a tie</button><button class=\"ds-chip\" type=\"button\" aria-pressed=\"true\">Laundry</button></div>",
      "css": ".ds-chip{font-family:var(--font-body),sans-serif;border:1px solid var(--line);border-radius:50px;padding:9px 14px;min-height:44px;background:transparent;color:var(--ink);font-size:.8rem;line-height:1.3;cursor:pointer;transition:background-color .2s ease,color .2s ease,opacity .2s ease;}.ds-chip:hover{border-color:var(--ink)}.ds-chip:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}@media(max-width:600px){.ds-chip{font-size:.73rem;padding:9px 12px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}.ds-chips{display:flex;flex-wrap:wrap;gap:9px}.ds-chip[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--paper)}"
    },
