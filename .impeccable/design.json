      "css": ".ds-secondary{font-family:var(--font-body),sans-serif;display:inline-flex;min-height:52px;justify-content:center;align-items:center;gap:14px;padding:13px 22px;border-radius:7px;border:1px solid transparent;font-weight:600;font-size:.94rem;line-height:1.4;text-decoration:none;white-space:normal;text-align:center;cursor:pointer;transition:background-color .2s ease,color .2s ease,opacity .2s ease;background:transparent;color:var(--ink);border-color:var(--line)}.ds-secondary:hover:not(:disabled){background:var(--soft)}.ds-secondary:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}.ds-secondary:disabled{opacity:.65;cursor:default}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
    },
