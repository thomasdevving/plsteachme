  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main signup action; shares keyboard focus and disabled state.",
      "html": "<button class=\"ds-primary\">Join the waitlist<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-primary{font-family:var(--font-body),sans-serif;display:inline-flex;min-height:52px;justify-content:center;align-items:center;gap:14px;padding:13px 22px;border-radius:7px;border:1px solid transparent;font-weight:600;font-size:.94rem;line-height:1.4;text-decoration:none;white-space:normal;text-align:center;cursor:pointer;transition:background-color .2s ease,color .2s ease,opacity .2s ease;background:var(--accent);color:var(--on-accent)}.ds-primary:hover:not(:disabled){background:var(--accent-hover)}.ds-primary:focus-visible{outline:3px solid var(--focus);outline-offset:4px;}.ds-primary:disabled{opacity:.65;cursor:default}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}"
